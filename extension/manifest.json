{
  "manifest_version": 3,
  "name": "Stems for YouTube",
  "version": "0.1.0",
  "description": "Separate any YouTube song into six stems locally with WebGPU. Stems start a few seconds after the click; replays are instant.",
  "minimum_chrome_version": "113",
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://*.googlevideo.com/*",
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/ui.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/host.html",
        "src/host.js"
      ],
      "matches": [
        "*://www.youtube.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
